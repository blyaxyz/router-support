#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=95
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance tunnel
    procd_set_param command /usr/sbin/router-support tunnel
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="128 128"
    procd_close_instance

    procd_open_instance heartbeat
    procd_set_param command /usr/sbin/router-support heartbeat-loop
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits nofile="64 64"
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger router-support
}

