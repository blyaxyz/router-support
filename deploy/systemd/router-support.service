[Unit]
Description=Router Support API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=router-tunnel
Group=router-tunnel
WorkingDirectory=/opt/router-support
EnvironmentFile=/etc/router-support/backend.env
ExecStart=/opt/router-support/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/router-support/data

[Install]
WantedBy=multi-user.target
